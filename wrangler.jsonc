{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "srp-blog",
	"compatibility_date": "2025-01-05",
	"assets": {
		"directory": "./out",
		"not_found_handling": "404-page"
	},
	// Route mode (not a Workers "Custom Domain").
	//
	// The route only intercepts traffic that already reaches Cloudflare under
	// this hostname, so `blog.srprolin.com` MUST have a proxied DNS record in the
	// `srprolin.com` zone (e.g. AAAA 100::, orange cloud). Unlike `custom_domain:
	// true`, deploying a route does NOT create that record or issue the
	// certificate for you — without it the hostname simply does not resolve.
	"routes": [
		{
			"pattern": "blog.srprolin.com/*",
			"zone_name": "srprolin.com"
		}
	]
}
