# Copy to `.env.local` for development, or set these in your deploy platform.
# Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.

# Base URL of the srp-blog-upv service (see `services/upv/README.md`).
# Leave unset to disable UV counters entirely: the UI degrades silently.
# Local example:  NEXT_PUBLIC_UPV_API=http://127.0.0.1:8787
NEXT_PUBLIC_UPV_API=
