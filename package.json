{
  "name": "srp-blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "tsx scripts/fetch-fonts.ts && tsx scripts/sync-post-assets.ts && tsx scripts/generate-og-image.ts --dev && tsx scripts/generate-third-party-licenses.ts && vite",
    "build": "tsx scripts/fetch-fonts.ts && tsx scripts/sync-post-assets.ts && tsx scripts/generate-og-image.ts && tsx scripts/generate-third-party-licenses.ts && react-router build && tsx scripts/build-pagefind.ts && tsx scripts/finalize-vite-build.ts && tsx scripts/verify-seo.ts",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "eslint --ext .ts,.tsx --max-warnings 0 .",
    "fonts": "tsx scripts/fetch-fonts.ts",
    "sync-assets": "tsx scripts/sync-post-assets.ts",
    "pagefind": "tsx scripts/build-pagefind.ts",
    "generate-licenses": "tsx scripts/generate-third-party-licenses.ts",
    "generate-og-image": "tsx scripts/generate-og-image.ts",
    "new-post": "node scripts/new-post.js",
    "verify-content": "tsx scripts/verify-content.ts",
    "verify-seo": "tsx scripts/verify-seo.ts"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@react-router/node": "7.18.5",
    "@waline/client": "^3.15.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "katex": "^0.16.21",
    "lucide-react": "^0.475.0",
    "next-themes": "^0.4.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-router": "7.18.5",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-pretty-code": "^0.14.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.1",
    "shiki": "^2.1.0",
    "tailwind-merge": "^3.0.1",
    "unified": "^11.0.5",
    "isbot": "^5"
  },
  "devDependencies": {
    "@react-router/dev": "7.18.5",
    "@tailwindcss/typography": "^0.5.20",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "pagefind": "^1.5.2",
    "postcss": "^8.5.2",
    "satori": "^0.63.2",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3",
    "vite": "^7.3.8",
    "vite-tsconfig-paths": "^6.1.1"
