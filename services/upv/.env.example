# ---------------------------------------------------------------------------
# srp-blog-upv service configuration (Node / Bun + SQLite deployment)
# Copy to `.env` and load it yourself, e.g.:
#   set -a && . ./.env && set +a && node --experimental-sqlite --experimental-strip-types src/server.ts
# ---------------------------------------------------------------------------

# HTTP port for the standalone Node/Bun server.
PORT=8787

# SQLite database file. Use `:memory:` for ephemeral test runs.
# On Docker the volume is mounted at /data, so keep the default there.
DB_PATH=./upv.sqlite

# Optional bind address (default 0.0.0.0).
HOST=0.0.0.0

# ---------------------------------------------------------------------------
# SALT: secret salt mixed into visitor_hash = sha256(ip + ua + utcDate + SALT).
# Strongly recommended in production: rotating it resets "unique visitor"
# identity for future visits (it can never be used to brute-force old rows
# because raw IPs are never persisted). Never commit a real value.
# If unset, the fixed development default "srp-blog-upv-dev-salt" is used and
# the server logs a warning.
# ---------------------------------------------------------------------------
SALT=change-me-to-a-long-random-string

# Comma-separated CORS allow-list. `*` allows every origin (default).
# Example: https://blog.example.com,https://www.blog.example.com
ALLOWED_ORIGINS=*

# ---------------------------------------------------------------------------
# Best-effort PV throttling. Milliseconds during which repeated POST /api/hit
# from the same IP for the same path are not counted again.
# 0 (default) disables the throttle so every request counts as a page view.
# Set 60000 for a 60s window. This is in-memory and per-isolate/process only;
# real bot protection must come from a reverse proxy / CDN in front.
# ---------------------------------------------------------------------------
THROTTLE_WINDOW_MS=0

# Set to `false` to count requests from known bot user agents (keyword match).
BLOCK_BOTS=true
