{
	"name": "srp-blog-upv",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Self-contained Unique Visitor / Page View counting service for srp-blog. Cloudflare Workers + D1, zero runtime dependencies.",
	"engines": {
		"node": ">=22.5"
	},
	"scripts": {
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"dev": "wrangler dev",
		"deploy": "wrangler deploy",
		"db:schema": "wrangler d1 execute srp-blog-stats --remote --file=./schema.sql",
		"db:export": "wrangler d1 export srp-blog-stats --remote --output=./backup-$(date +%Y%m%d).sql"
	},
	"dependencies": {},
	"devDependencies": {}
}
