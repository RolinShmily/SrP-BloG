# ---------------------------------------------------------------------------
# Build output — regenerated by `pnpm build`, never committed
# ---------------------------------------------------------------------------
dist/
.next/
out/
*.tsbuildinfo

# ---------------------------------------------------------------------------
# public/ holds two kinds of file, because its layout IS the site's URL space:
#
#   sources      committed, hand-maintained, the path IS the URL
#                (favicon/, sponsors/, search-engine verification files)
#   derivatives  written by the prebuild chain, never committed — listed below
#
# A denylist is deliberate here. An allowlist ("ignore public/*, then re-include
# each source") fails silently: a new source file stays on your disk, so `pnpm
# dev` still works, but CI's checkout lacks it and the deployed site 404s. This
# form fails loudly instead — new generated output shows up as an untracked file
# in `git status` before it can be committed.
#
# `pnpm dev` and `pnpm build` regenerate everything listed below, so none of it
# needs to survive being cloned. Anything new that writes into public/ belongs
# in this section too. Note that gitignore comments must own their whole line —
# a trailing `# ...` on a pattern line is parsed as part of the pattern.
# ---------------------------------------------------------------------------

# scripts/sync-post-assets.ts — mirror of the co-located assets in content/posts/**
public/posts/

# scripts/generate-search-index.ts — client-side search index
public/search-index.json

# ---------------------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------------------
node_modules/

# ---------------------------------------------------------------------------
# Environment variables — real values are never committed. `.env.example` is the
# committed template, so it must NOT match any pattern below. `.env*.local` is
# the Next.js override convention (.env.local, .env.development.local, …); it
# was missing before, which made a stray `.env.local` committable.
# ---------------------------------------------------------------------------
.env
.env.production
.env*.local

# ---------------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------------------------
# Editor / OS cruft (Windows junk regenerates on every sync)
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea
*.iml

# ---------------------------------------------------------------------------
# Tooling scratch
# ---------------------------------------------------------------------------
.vercel
.wrangler
tmpclaude-*-cwd

# Lockfiles for the package managers this repo does not use — pnpm-lock.yaml IS
# committed, so leave it out of here.
package-lock.json
bun.lockb
yarn.lock

# Local agent / editor config, never shared
CLAUDE.md
.spec-workflow
.vscode/
.claude/
skills-lock.json
.agents
.memory

acofork/
